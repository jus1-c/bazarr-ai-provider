# Required paths
BAZARR_CONFIG_DIR=/path/to/bazarr/config
MEDIA_DIR=/path/to/media

# linuxserver/bazarr runtime identity
PUID=1000
PGID=1000
TZ=Etc/UTC

# Published ports
BAZARR_PORT=6767
AIPROXY_WORKER_PORT=8787

# aiproxy provider behavior
AIPROXY_TIMEOUT=60
AIPROXY_BUILTIN_ENABLED=true
AIPROXY_AI_FALLBACK_ENABLED=true
AIPROXY_AI_FALLBACK_MAX_CANDIDATES=10
AIPROXY_WORKER_FALLBACK=true
AIPROXY_MAX_RESULTS=25

# Replace mode only: keep Bazarr enabled_providers as only aiproxy and list real backend providers here.
# Leave empty for augment mode, where aiproxy uses Bazarr's enabled providers excluding itself.
AIPROXY_BUILTIN_PROVIDERS=

# Local OpenAI-compatible endpoint. Leave OPENAI_BASE_URL empty to disable AI scoring.
OPENAI_BASE_URL=http://local-openai-compatible:8000/v1
OPENAI_API_KEY=dummy
OPENAI_MODEL=local-model
AI_ENABLED=true
AI_THRESHOLD=85
HTTP_TIMEOUT=30

# Optional override. If empty, worker reads subsource.apikey from Bazarr config.
SUBSOURCE_API_KEY=
